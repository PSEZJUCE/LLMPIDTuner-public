# Backward-compatible default OpenAI-compatible LLM settings.
# Copy this file to .env and fill in private values locally.
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-1.7b
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.1
LLM_ENABLE_THINKING=false

# Profile-based provider settings.
# A case selects both provider and model with:
#   llm_profile: DS_Deepseek-V4-Flash
#   llm_profile: vLLM_llama3.1-8b
#
# The part before "_" chooses the provider env group. The part after "_"
# is normalized into the API model name and recorded in run metadata.
# .env should normally store only provider secrets and endpoints.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Sampling and thinking settings should normally be fixed in each eval YAML.
DEEPSEEK_ENABLE_THINKING=false

OLLAMA_API_KEY=EMPTY
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.1

VLLM_API_KEY=EMPTY
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_TEMPERATURE=0.1
VLLM_TOP_P=0.1
VLLM_ENABLE_THINKING=false

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen uses extra_body.enable_thinking; eval YAMLs set it explicitly.
QWEN_ENABLE_THINKING=false

SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# Optional default run behavior.
LLMPIDTUNER_OUTPUT_DIR=runs
